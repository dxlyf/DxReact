{
  "name": "minigfx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A thin, low-level graphics library that wraps WebGL, WebGL2 and WebGPU without hiding their native capabilities.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:examples": "tsc -p examples/tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "serve": "node scripts/serve.mjs",
    "start": "npm run build && npm run build:examples && node scripts/serve.mjs"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.53",
    "typescript": "^5.6.3"
  }
}
